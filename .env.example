# Copy this file to .env and add your keys. Never commit .env.

# --- API keys ---
# Groq: https://console.groq.com/keys (primary provider)
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey (fallback)
GEMINI_API_KEY=

# --- Models ---
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
# Ollama runs locally and requires no key: `ollama pull qwen2.5:7b`
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Provider chain ---
# Primary provider and ordered fallbacks (JSON format).
# Without a Gemini key, use FALLBACKS=["ollama"].
PRIMARY=groq
FALLBACKS=["gemini","ollama"]

# --- Reliability ---
TIMEOUT_S=60
OLLAMA_TIMEOUT_S=300
MAX_RETRIES=3
# Maximum repairs when a response fails RespuestaConCitas validation.
MAX_REPAIRS=2

# --- Ingestion ---
DOCS_DIR=data/docs
INDEX_DIR=data/index
# Maximum chunk size and overlap in characters.
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Retrieval ---
# sentence-transformers models (downloaded to the Hugging Face cache on first use).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Candidates per retriever before fusion/reranking; chunks passed to the LLM.
TOP_K_CANDIDATES=20
TOP_K=5
RRF_K=60
# Minimum relevance for the best chunk; lower scores return "no information found" without
# calling the LLM. MIN_RELEVANCE applies to hybrid_rerank; MIN_VECTOR_SIMILARITY applies
# to the best vector cosine score for vector, bm25, and hybrid. Calibrate with
# `scripts/eval_retrieval.py --verbose`; cross-encoders can score paraphrases conservatively.
MIN_RELEVANCE=0.01
MIN_VECTOR_SIMILARITY=0.80

# --- Observability ---
LOG_PATH=logs/llm_calls.jsonl
