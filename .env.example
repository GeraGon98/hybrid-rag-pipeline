# Copia este archivo a .env y llena tus llaves. Nunca subas .env al repositorio.

# --- Llaves de API ---
# Groq: https://console.groq.com/keys (proveedor principal)
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey (respaldo)
GEMINI_API_KEY=

# --- Modelos ---
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
# Ollama corre local y no necesita llave: `ollama pull qwen2.5:7b`
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Cadena de proveedores ---
# Proveedor principal y respaldos en orden (formato JSON).
# Si no tienes llave de Gemini, usa FALLBACKS=["ollama"].
PRIMARY=groq
FALLBACKS=["gemini","ollama"]

# --- Robustez ---
TIMEOUT_S=60
OLLAMA_TIMEOUT_S=300
MAX_RETRIES=3
# Reparaciones máximas cuando la respuesta no valida contra RespuestaConCitas.
MAX_REPAIRS=2

# --- Ingesta ---
DOCS_DIR=data/docs
INDEX_DIR=data/index
# Tamaño máximo y solapamiento de cada chunk, en caracteres.
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Recuperación ---
# Modelos de sentence-transformers (se descargan la primera vez a la caché de Hugging Face).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Candidatos por buscador antes de fusionar y reordenar; chunks que llegan al LLM.
TOP_K_CANDIDATES=20
TOP_K=5
RRF_K=60
# Relevancia mínima del mejor chunk; debajo se responde "no encontré información" sin llamar
# al LLM. MIN_RELEVANCE aplica al score del reranker (hybrid_rerank) y MIN_VECTOR_SIMILARITY
# al coseno del mejor resultado vectorial (vector, bm25 y hybrid). Calibrados con
# `scripts/eval_retrieval.py --verbose`: el cross-encoder da scores bajos a paráfrasis.
MIN_RELEVANCE=0.01
MIN_VECTOR_SIMILARITY=0.80

# --- Observabilidad ---
LOG_PATH=logs/llm_calls.jsonl
